/AikiField homepage accessibility redesign.zip

# AI coding config / secrets
.env*
*.key
*.pem
credentials.json
.devin/config.local.json
# Coaching auth — local override holds the real PROXY_SECRET (never commit)
coach-config.local.php
# Vim swap files
*.swp
*.swo

# Convergence-driver audit output (regenerated on every run)
data/audit/

# contact-handler.php per-IP rate-limit counters (regenerated on every run)
data/ratelimit/

# Downloaded access logs — contain visitor IPs, never commit
logs/

# Python bytecode cache
__pycache__/
*.pyc

# Node.js / Playwright (e2e test suite)
node_modules/

# Visual-regression review artifacts (tests/e2e/specs/visual.spec.js writes
# dated screenshot folders here; the committed baselines live in
# tests/e2e/visual-baselines/)
docs/ui-review/

# Local CI run output (scripts/ci-local.sh)
ci-results/
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.stub-*.jsonl
# Runtime player data (game results, review comments) — never commit.
data/private/*.json
