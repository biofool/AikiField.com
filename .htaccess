# AikiField.com — Apache rewrite rules + caching + security headers
# The site is static HTML; the only rewrite needed is the coach API proxy,
# which forwards /coach-api/* to coach-proxy.php (PHP proxy to the AI Ki
# Questions Fielded backend on Cloud Run). The proxy is used by the blind
# /login.php page that gates the /beta/ assessment pages. See
# docs/coach-auth-prd.md.

# ── Security headers ────────────────────────────────────────────────────────
# Suppress X-Powered-By (leaks PHP version on dynamic pages)
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always set X-Powered-By ""
  # Pin Vary: the host adds User-Agent, which fragments the
  # Cloudflare edge cache per visitor (see issue #25).
  Header always set Vary "Accept-Encoding"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  # HSTS: "Always Use HTTPS" at Cloudflare is only a 301 redirect - it does
  # not stop a MITM from intercepting the very first plaintext HTTP request
  # (SSL-stripping). This site collects credentials (login.php) and PII
  # (contact form), so pin browsers to HTTPS-only for this host. Mirrored at
  # the Cloudflare edge via the "security_header" zone setting in
  # scripts/cloudflare_migrate.py.
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
</IfModule>

# ── Canonical redirects ────────────────────────────────────────────────────
RewriteEngine On

# ── Origin lock: only accept HTTP(S) from Cloudflare edge IPs (issue #46) ──
# Without this, anyone who discovers the origin IP (e.g. via dig mail.aikifield.com)
# can bypass Cloudflare's WAF, rate limiting, and SSL by hitting the origin directly.
# Cloudflare's IP ranges: https://www.cloudflare.com/ips-v4/ and /ips-v6/
# The list is mirrored in includes/cloudflare-ips.php (PHP) for coach-proxy.php.
# Update both when Cloudflare publishes changes (quarterly check).
#
# Uses mod_authz_host Require ip (CIDR-native for both IPv4 and IPv6) instead of
# mod_rewrite regex — IPv6 CIDR matching in mod_rewrite regex is impractical for
# /32 and /29 prefixes. mod_authz_host is already confirmed available on this
# host (data/ratelimit/.htaccess uses "Require all denied").
<IfModule mod_authz_host.c>
  <RequireAny>
    # Cloudflare IPv4 ranges (https://www.cloudflare.com/ips-v4/)
    Require ip 173.245.48.0/20
    Require ip 103.21.244.0/22
    Require ip 103.22.200.0/22
    Require ip 103.31.4.0/22
    Require ip 141.101.64.0/18
    Require ip 108.162.192.0/18
    Require ip 190.93.240.0/20
    Require ip 188.114.96.0/20
    Require ip 197.234.240.0/22
    Require ip 198.41.128.0/17
    Require ip 162.158.0.0/15
    Require ip 104.16.0.0/13
    Require ip 104.24.0.0/14
    Require ip 172.64.0.0/13
    Require ip 131.0.72.0/22
    # Cloudflare IPv6 ranges (https://www.cloudflare.com/ips-v6/)
    Require ip 2400:cb00::/32
    Require ip 2606:4700::/32
    Require ip 2803:f800::/32
    Require ip 2405:b500::/32
    Require ip 2405:8100::/32
    Require ip 2a06:98c0::/29
    Require ip 2c0f:f248::/32
    # Health checks from localhost
    Require ip 127.0.0.1
    Require ip ::1
  </RequireAny>
</IfModule>
# Fallback: if mod_authz_host is unavailable, use mod_rewrite for IPv4 only.
# IPv6 cannot be reliably matched with mod_rewrite regex for /32 and /29 prefixes.
<IfModule !mod_authz_host.c>
  <IfModule mod_rewrite.c>
    RewriteCond %{REMOTE_ADDR} ^173\.245\.4[8-9]\.|^173\.245\.5[0-9]\.|^173\.245\.6[0-3]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^103\.21\.24[4-7]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^103\.22\.20[0-3]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^103\.31\.4\. [OR]
    RewriteCond %{REMOTE_ADDR} ^141\.10[1-2]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^108\.162\.(19[2-9]|2[0-4][0-9]|25[0-5])\. [OR]
    RewriteCond %{REMOTE_ADDR} ^190\.93\.24[0-9]\.|^190\.93\.25[0-5]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^188\.114\.9[6-9]\.|^188\.114\.10[0-9]\.|^188\.114\.11[0-1]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^197\.234\.24[0-3]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^198\.41\.(12[8-9]|1[3-9][0-9]|2[0-4][0-9]|25[0-5])\. [OR]
    RewriteCond %{REMOTE_ADDR} ^162\.15[8-9]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^104\.1[6-9]\.|^104\.2[0-3]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^104\.2[4-7]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^172\.6[4-9]\.|^172\.7[0-1]\. [OR]
    RewriteCond %{REMOTE_ADDR} ^131\.0\.7[2-5]\.
    RewriteCond %{REMOTE_ADDR} !^127\.0\.0\.1$
    RewriteRule ^ - [F]
  </IfModule>
</IfModule>

# ── Staging surfaces (issue #80) ────────────────────────────────────────────
# aikifield.peec.biz shares this Apache vhost/docroot with aikifield.com
# (cPanel serveralias) — the vhost cannot be split without root access, so
# staging is split by Host here instead. The staging-mirror symlink inside
# this docroot points at public_html/aikifield-staging/, the staging remote's
# deploy target. All rules are Host-gated so they are inert on aikifield.com
# and inside the staging docroot itself (staging.peec.biz gets its own rules).

# aikifield.peec.biz: canonicalize www → non-www and http → https WITHOUT
# bouncing to aikifield.com (the generic redirects below would otherwise
# send staging visitors to production).
RewriteCond %{HTTP_HOST} ^www\.aikifield\.peec\.biz$ [NC]
RewriteRule ^(.*)$ https://aikifield.peec.biz/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^aikifield\.peec\.biz$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://aikifield.peec.biz/$1 [R=301,L]

# staging.peec.biz: http → https preserving the staging host (the generic
# redirect below would bounce to aikifield.com).
RewriteCond %{HTTP_HOST} ^(www\.)?staging\.peec\.biz$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://staging.peec.biz/$1 [R=301,L]

# Never serve the staging-mirror symlink directly (aikifield.com/staging-mirror/*
# would leak the staging tree under the prod domain). Requests whose URI maps
# inside the symlink are handled by THIS file again in the staging-mirror/
# directory context — the staging-mirror/ prefix is already stripped there,
# so a ^staging-mirror URI pattern can never match; match REQUEST_URI
# instead. The REDIRECT_STATUS guard keeps direct requests (empty) distinct
# from the internal mirror sub-requests below (non-empty).
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_URI} ^/staging-mirror(/|$)
RewriteRule ^ - [F]

# aikifield.peec.biz IS the staging site: internally rewrite every request
# into the staging-mirror symlink (→ public_html/aikifield-staging/). The
# REQUEST_URI negative-match (rather than REDIRECT_STATUS) is what makes
# this safe across multiple passes: absolute-path rewrites later in this
# file (e.g. the /es/ locale strip) restart the URI at the docroot with
# REDIRECT_STATUS already set — without this, locale URLs on
# aikifield.peec.biz would silently fall back to the production docroot.
# The -d guard keeps this inert once aikifield.peec.biz gets its own vhost
# with docroot public_html/aikifield-staging/ (issue #81): that docroot has
# no staging-mirror, so rewriting into it would 404 the whole staging site.
RewriteCond %{HTTP_HOST} ^aikifield\.peec\.biz$ [NC]
RewriteCond %{DOCUMENT_ROOT}/staging-mirror -d
RewriteCond %{REQUEST_URI} !^/staging-mirror(/|$)
RewriteRule ^(.*)$ staging-mirror/$1 [L]

# staging.peec.biz/<project>/* — identical alias pattern for every project:
# redirect to the project's own staging subdomain, path preserved.
# (In-place mounts are not symmetric — /aikifield could only serve in place
# because this vhost's docroot IS the aikifield staging site, while QA lives
# in a different docroot whose root-relative links could not resolve here.)
RewriteCond %{HTTP_HOST} ^(www\.)?staging\.peec\.biz$ [NC]
RewriteRule ^aikifield/?(.*)$ https://aikifield.peec.biz/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?staging\.peec\.biz$ [NC]
RewriteRule ^quantumaikido/?(.*)$ https://quantumaikido.peec.biz/$1 [R=301,L]

# www → non-www (single canonical domain)
RewriteCond %{HTTP_HOST} ^www\.aikifield\.com$ [NC]
RewriteRule ^(.*)$ https://aikifield.com/$1 [R=301,L]

# http → https (force HTTPS for all traffic)
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://aikifield.com/$1 [R=301,L]

# ── Rewrites ────────────────────────────────────────────────────────────────

# Locale path prefix — strip /xx/ and serve the underlying file internally.
# e.g. /es/projects.php → /projects.php, /es/ → /index.html
# The locale is detected client-side by locale-utils.js (localeFromPath()).
# Only 2-letter locale prefixes that have real translations are listed.
# 'en' is the default locale — /en/ redirects to the non-prefixed URL.
RewriteRule ^(en|es)/?$ /index.html [L]
RewriteRule ^(en|es)/(.+)$ /$2 [L]

# Coach API proxy — forward /coach-api/* to coach-proxy.php
RewriteRule ^coach-api(/.*)?$ coach-proxy.php [L]

# Operations dashboard — blind (not linked from nav, not localizable).
# Access via /dashboard.php?key=<DASHBOARD_ADMIN_KEY>.
RewriteRule ^(en|es|fr|de|pt|ja|zh|ko|ar|he|fa|hi)/dashboard\.php$ /dashboard.php [R=301,L]

# Demonstration Technologies is a PHP page (kept as .php for this redirect
# and because /beta/ pages link to it). Permanently redirect the old static
# URL so existing internal/external links keep working.
RewriteRule ^projects\.html$ /projects.php [R=301,L]

# /members — AI Chat ("Enter the Unified Field Chat", Digital Experience
# menu). Extensionless URL mirrors quantumaikido.com/members. members.php is
# session-gated (beta-gate.load.php) and redirects to /login.php when unauthed.
RewriteRule ^members/?$ members.php [L]

# Digital Experience games were promoted out of the gated review area to the
# public /games/ tree. Permanently redirect the old gated URLs. These MUST stay
# above the /for-review/ catch-all below, or that rule swallows them first.
RewriteRule ^for-review/games/(lucky-wave|verbal-aikido)(/.*)?$ /games/$1$2 [R=301,L]

# /ask/* — Ask AikiField AEO knowledge layer (issue #65). Public, indexable
# sourced Q&A pages; ask/index.php renders them dynamically from data/ask/.
RewriteRule ^ask(/.*)?$ /ask/index.php [L]

# /for-review/* — gated games review area (moved from
# quantumaikido.com/for-review/games*). Every request is routed through
# includes/for-review-serve.php, which requires the same coaching session
# as /beta/ (existing QA accounts sign in via /login.php?next=…) and then
# serves the file. This also gates assets, so review content never reaches
# the Cloudflare edge cache unauthenticated.
RewriteRule ^for-review(/.*)?$ includes/for-review-serve.php [L]

# /beta/ assessment pages are session-gated PHP (gated by the blind
# /login.php coaching login). Redirect the old static URLs so existing
# links keep working.
RewriteRule ^beta/assessment\.html$ /beta/assessment.php [R=301,L]
RewriteRule ^beta/assessment-organisation\.html$ /beta/assessment-organisation.php [R=301,L]
RewriteRule ^beta/assessment-leadership\.html$ /beta/assessment-leadership.php [R=301,L]
RewriteRule ^beta/assessment-crossview\.html$ /beta/assessment-crossview.php [R=301,L]

# /games/ Digital Experience entry points are session-gated PHP (issue #71 —
# same blind /login.php gate as /beta/ and /members). Redirect the old static
# URLs so existing links and bookmarks keep working.
RewriteRule ^games/lucky-wave/RideTheLuckyWaveV1-legacy\.html$ /games/lucky-wave/RideTheLuckyWaveV1-legacy.php [R=301,L]
RewriteRule ^games/lucky-wave/RideTheLuckyWaveV2\.html$ /games/lucky-wave/RideTheLuckyWaveV2.php [R=301,L]
RewriteRule ^games/verbal-aikido/index\.html$ /games/verbal-aikido/ [R=301,L]
RewriteRule ^games/exercises/index\.html$ /games/exercises/ [R=301,L]

# ── Caching ────────────────────────────────────────────────────────────────

# Static HTML pages — cache for 1 hour (short enough to pick up content
# changes, long enough to avoid revalidation on repeat visits within a
# session). PHP pages send their own no-cache headers.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Site JSON (i18n strings/config, welcome messages, terminology) — mutable
  # render-critical content read by locale-utils.js on every page load. A
  # missing header let browsers/edge heuristic-cache stale strings, which
  # reverted freshly-deployed text after first paint (issue #73). Keep a
  # short TTL with revalidation so deploys propagate in minutes.
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
</IfModule>

# Static assets (CSS, JS, SVG, fonts, images) — cache for 1 year with
# immutable flag. These files rarely change, and when they do the
# last-modified/etag will still allow revalidation if needed.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|woff|woff2|ttf|eot|otf|png|jpg|jpeg|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Fallback for mod_expires if mod_headers is unavailable
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
